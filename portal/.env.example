# ---- 本站 ----
# 🔴 多節點掛在負載平衡器後面時，每個節點的 SESSION_SECRET 必須完全相同，
#    否則 A 節點簽的 session 到 B 節點會驗不過（US-20 無狀態的前提）。
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_MINUTES=480
# 可查稽核端點的人（UPN，逗號分隔）；留空 = 停用稽核查詢
AUDITOR_UPNS=

# ---- AD (LDAP bind) ----
LDAP_URL=ldap://10.0.0.200:389
LDAP_BASE_DN=DC=home,DC=lab
LDAP_UPN_SUFFIX=@home.lab
# 讀取使用者屬性用的服務帳號（可留空 = 用登入者自己的憑證讀）
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=
LDAP_USE_SSL=false

# ---- vRA ----
VRA_URL=https://vra.home.lab
VRA_USERNAME=svc-vmportal
VRA_PASSWORD=change-me
VRA_DOMAIN=System Domain
VRA_PROJECT_ID=00000000-0000-0000-0000-000000000000
VRA_BLUEPRINT_ID=00000000-0000-0000-0000-000000000000
VRA_VERIFY_TLS=false

# ---- vCenter（把申請資訊寫成 VM 的自訂屬性）----
# 留空 = 停用這個功能
VC_HOST=10.0.0.101
VC_USERNAME=svc-vmportal@vsphere.local
VC_PASSWORD=change-me
VC_VERIFY_TLS=false
# portal 欄位 -> vCenter 自訂屬性名稱；改成客戶現有的欄位名
VC_FIELD_MAP={"requester":"customOwner","employeeId":"customEmployeeId","ticket":"customTicket","purpose":"customPurpose","purposeNote":"customNote"}
# 欄位不存在時自動建立（需 Global.ManageCustomFields 權限）
VC_CREATE_FIELDS=false
