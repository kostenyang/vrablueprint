{
  "_comment": [
    "Custom attribute field definitions. To add or remove a field, edit this file only.",
    "No blueprint change, no code change, no template change is required.",
    "",
    "source  = ad   filled in from Active Directory (shown but not editable, so it cannot be spoofed)",
    "source  = user entered by the requester on the form",
    "type    = text | textarea | select   (only meaningful when source = user)",
    "vcAttribute = the vCenter custom attribute to write to; use the customer's existing field name",
    "Leave vcAttribute empty to keep the value in vRA only, without writing it to vCenter."
  ],

  "fields": [
    {
      "key": "requester",
      "label": "Requester",
      "source": "ad",
      "adAttribute": "userPrincipalName",
      "vcAttribute": "customOwner"
    },
    {
      "key": "employeeId",
      "label": "Employee ID",
      "source": "ad",
      "adAttribute": "employeeID",
      "adFallback": "employeeNumber",
      "vcAttribute": "customEmployeeId"
    },
    {
      "key": "department",
      "label": "Department",
      "source": "ad",
      "adAttribute": "department",
      "vcAttribute": "customDepartment"
    },
    {
      "key": "ticket",
      "label": "Request ticket",
      "source": "user",
      "type": "text",
      "required": true,
      "placeholder": "e.g. REQ0012345",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,31}$",
      "patternHint": "3-32 characters; letters, digits and . _ - only",
      "vcAttribute": "customTicket"
    },
    {
      "key": "purpose",
      "label": "Purpose",
      "source": "user",
      "type": "select",
      "required": true,
      "options": [
        { "value": "test", "label": "Test" },
        { "value": "dev", "label": "Development" },
        { "value": "prod", "label": "Production" },
        { "value": "poc", "label": "POC" }
      ],
      "vcAttribute": "customPurpose"
    },
    {
      "key": "purposeNote",
      "label": "Notes",
      "source": "user",
      "type": "textarea",
      "required": false,
      "placeholder": "What this machine is for",
      "maxLength": 200,
      "vcAttribute": "customNote"
    }
  ]
}
